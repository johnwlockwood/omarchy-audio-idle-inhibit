[Unit]
Description=Keep the session awake while audio is playing
Documentation=https://github.com/johnwlockwood/omarchy-audio-idle-inhibit
After=pipewire-pulse.service graphical-session.target
Wants=pipewire-pulse.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/audio-idle-inhibit
Restart=always
RestartSec=3
SuccessExitStatus=143

[Install]
WantedBy=graphical-session.target
